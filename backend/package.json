{
  "name": "lifeos-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "tsx -e \"import('dotenv').then(d => d.config()); if((process.env.NODE_ENV||'').toLowerCase()==='production'){console.error('db:seed blocked in production');process.exit(1)}\" && sequelize-cli db:seed:all",
    "test": "tsx -e \"if((process.env.NODE_ENV||'').toLowerCase()==='production'){console.error('test blocked in production');process.exit(1)}\" && jest --runInBand",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.5",
    "pino": "^9.3.2",
    "redis": "^4.7.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
