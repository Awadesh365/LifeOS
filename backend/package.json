{
  "name": "@lifeos/backend",
  "version": "1.0.0",
  "private": true,
  "description": "LifeOS API server",
  "type": "commonjs",
  "scripts": {
    "dev": "bash scripts/with-nvm-node.sh bash scripts/start-dev.sh",
    "build": "bash scripts/with-nvm-node.sh sh -c 'rm -rf dist && tsc && mkdir -p dist/data && cp data/articles.json dist/data/articles.json'",
    "start": "bash scripts/with-nvm-node.sh node dist/src/server.js",
    "test": "bash scripts/with-nvm-node.sh node --import tsx --test tests/**/*.test.ts",
    "test:maintenance:db": "bash scripts/with-nvm-node.sh node --import tsx scripts/maintenance-test-db.ts",
    "db:start": "bash scripts/local-postgres.sh start",
    "db:stop": "bash scripts/local-postgres.sh stop",
    "db:status": "bash scripts/local-postgres.sh status",
    "db:migrate": "sequelize-cli db:migrate",
    "seed:check-safe": "node scripts/validate-seeders-safe.js",
    "db:seed": "npm run seed:check-safe && sequelize-cli db:seed:all",
    "seed:local": "bash scripts/with-nvm-node.sh tsx scripts/seed.ts",
    "db:sync": "bash scripts/with-nvm-node.sh tsx scripts/push.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.0",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
