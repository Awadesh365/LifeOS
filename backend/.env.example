# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifeos
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeos
DATABASE_DIRECT_URL=postgres://postgres:postgres@localhost:5432/lifeos
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=lifeos

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT Secrets (separate per audience)
JWT_SECRET=dev-cms-secret-change-in-prod
CUSTOMER_JWT_SECRET=dev-customer-secret-change-in-prod

# Feature Flags
RECOMMENDATIONS_ENABLED=true
ANALYTICS_ENABLED=true
EMAILS_ENABLED=true

# Rate Limiting
TRUSTED_PROXY_COUNT=0
