BACKEND_PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Active local database. Keep exactly one connection strategy active.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=lifeos
DB_USER=postgres
DB_PASSWORD=postgres

# Optional runtime URL (for example, PgBouncer). When set, it overrides DB_* at runtime.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/lifeos

# Optional direct PostgreSQL URL used by migrations and database administration.
# DATABASE_DIRECT_URL=postgres://postgres:postgres@127.0.0.1:5433/lifeos

DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_POOL_EVICT_MS=10000
